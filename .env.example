# Environment Configuration for TextMine

# Required: Google Gemini API Key
# Get it from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Gemini model override. Use a model available in your Google AI Studio account.
# Examples: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# Optional: Tesseract OCR Path
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: If installed via package manager, leave blank or set to /usr/bin/tesseract
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
